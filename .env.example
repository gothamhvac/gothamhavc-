# Google Ads conversion tracking (see src/lib/gtag.ts)
# The account id below is already the default in code — the base tag loads on
# every page without any env config. Only the conversion LABELS need filling in.
#
# Copy each "send_to" value from Google Ads:
#   Goals > Conversions > Summary > [action] > Tag setup > Use Google tag
#   -> send_to: 'AW-17972837903/AbC-D_efG123'
# Until a label is set, that conversion event stays inert.
# NEXT_PUBLIC_GADS_ID="AW-17972837903"
NEXT_PUBLIC_GADS_PHONE_CONV="AW-17972837903/PHONE_LABEL"
NEXT_PUBLIC_GADS_FORM_CONV="AW-17972837903/FORM_LABEL"
