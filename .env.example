# Google Ads conversion tracking (see src/lib/gtag.ts)
# These are the live values and are already the defaults in code — the tag and
# both conversions work without any env config. Set them here only to override,
# e.g. to point a preview deploy at a test conversion action.
#
# Values come from: Google Ads > Goals > Conversions > Summary >
#   [action] > Tag setup > Use Google tag  ->  send_to: 'AW-.../<label>'
# NEXT_PUBLIC_GADS_TAG_ID=AW-17972837903
# NEXT_PUBLIC_GADS_PHONE_CONV=AW-17972837903/sIOFCND_tPkcEI_8jvpC
# NEXT_PUBLIC_GADS_FORM_CONV=AW-17972837903/fEylCM3_tPkcEI_8jvpC
