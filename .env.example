# Google Ads conversion tracking (see src/lib/gtag.ts)
# Copy the "send_to" value Google Ads shows for each conversion action:
#   Google Ads > Goals > Conversions > Summary > [action] > Tag setup >
#   Use Google tag  ->  send_to: 'AW-1234567890/AbC-D_efG123'
# Leave unset to keep the AW-XXXXXXXXX placeholders (tracking stays inert).
NEXT_PUBLIC_GADS_PHONE_CONV="AW-XXXXXXXXX/PHONE_LABEL"
NEXT_PUBLIC_GADS_FORM_CONV="AW-XXXXXXXXX/FORM_LABEL"
